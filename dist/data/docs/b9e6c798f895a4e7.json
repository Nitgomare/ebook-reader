{"id":"b9e6c798f895a4e7","bookSlug":"robot-textbook","relPath":"appendix/appendix_e.md","title":"附录E 常见故障排查表","sections":["附录"],"excerpt":"","order":17,"previousId":"1c3f17bf239803fb","nextId":"4f46407ebacefb36","html":"<h2 id=\"e\">附录E 常见故障排查表</h2>\n<h3 id=\"e1\">E.1 机械系统</h3>\n<table>\n<thead>\n<tr>\n<th style=\"text-align: left;\">故障现象</th>\n<th style=\"text-align: left;\">可能原因</th>\n<th style=\"text-align: left;\">排查方法</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left;\">关节转动卡滞</td>\n<td style=\"text-align: left;\">轴承安装不正、减速器缺油</td>\n<td style=\"text-align: left;\">重新装配，补充润滑脂</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">关节异响</td>\n<td style=\"text-align: left;\">螺栓松动、轴承磨损</td>\n<td style=\"text-align: left;\">检查扭矩，更换轴承</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">轮子端面跳动大</td>\n<td style=\"text-align: left;\">轮胎安装不同心</td>\n<td style=\"text-align: left;\">重新安装轮胎，调整锁紧螺母</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">机器人跑偏</td>\n<td style=\"text-align: left;\">轮径不一致、轮距参数错误</td>\n<td style=\"text-align: left;\">校准轮径，修正轮距</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">结构变形</td>\n<td style=\"text-align: left;\">动态载荷过大、材料疲劳</td>\n<td style=\"text-align: left;\">有限元复核，更换加强件</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"e2\">E.2 硬件系统</h3>\n<table>\n<thead>\n<tr>\n<th style=\"text-align: left;\">故障现象</th>\n<th style=\"text-align: left;\">可能原因</th>\n<th style=\"text-align: left;\">排查方法</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left;\">电源无输出</td>\n<td style=\"text-align: left;\">DC-DC虚焊、芯片损坏</td>\n<td style=\"text-align: left;\">检查焊接，测量输入输出</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">MCU不工作</td>\n<td style=\"text-align: left;\">晶振不起振、复位异常</td>\n<td style=\"text-align: left;\">示波器看晶振波形，检查复位电路</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">电机不转</td>\n<td style=\"text-align: left;\">PWM无输出、MOS管损坏、驱动使能未打开</td>\n<td style=\"text-align: left;\">检查PWM波形，测量MOS管栅极电压</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">电机电流过大</td>\n<td style=\"text-align: left;\">参数配置错误、负载过大</td>\n<td style=\"text-align: left;\">检查FOC参数，减小负载</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">电源纹波过大</td>\n<td style=\"text-align: left;\">滤波电容不足、地线布局差</td>\n<td style=\"text-align: left;\">增加去耦电容，优化PCB布局</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"e3\">E.3 软件系统</h3>\n<table>\n<thead>\n<tr>\n<th style=\"text-align: left;\">故障现象</th>\n<th style=\"text-align: left;\">可能原因</th>\n<th style=\"text-align: left;\">排查方法</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left;\">IMU数据为零</td>\n<td style=\"text-align: left;\">SPI通信失败、CS引脚错误</td>\n<td style=\"text-align: left;\">逻辑分析仪抓取SPI波形</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">编码器角度跳变</td>\n<td style=\"text-align: left;\">接触不良、磁场干扰</td>\n<td style=\"text-align: left;\">检查连接，调整磁铁与芯片间距</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">看门狗复位</td>\n<td style=\"text-align: left;\">控制中断超时、死循环</td>\n<td style=\"text-align: left;\">检查中断执行时间，优化代码</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">导航定位丢失</td>\n<td style=\"text-align: left;\">激光雷达被遮挡、AMCL粒子发散</td>\n<td style=\"text-align: left;\">清洁雷达，重新设置初始位姿</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">任务无法启动</td>\n<td style=\"text-align: left;\">任务配置文件格式错误</td>\n<td style=\"text-align: left;\">检查JSON/YAML语法</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">报警不触发</td>\n<td style=\"text-align: left;\">感知节点未发布事件</td>\n<td style=\"text-align: left;\">检查感知系统话题</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"e4\">E.4 运动控制</h3>\n<table>\n<thead>\n<tr>\n<th style=\"text-align: left;\">故障现象</th>\n<th style=\"text-align: left;\">可能原因</th>\n<th style=\"text-align: left;\">排查方法</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left;\">机器人无法站立</td>\n<td style=\"text-align: left;\">平衡控制器参数不正确、IMU零偏未校准</td>\n<td style=\"text-align: left;\">重新标定IMU，调整LQR增益</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">轮式移动抖动</td>\n<td style=\"text-align: left;\">速度环增益过大、编码器噪声</td>\n<td style=\"text-align: left;\">降低速度环Kp，滤波编码器</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">转向过度/不足</td>\n<td style=\"text-align: left;\">差速解算错误、轮径不一致</td>\n<td style=\"text-align: left;\">校准轮径，修正轮距参数</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">越障时摔倒</td>\n<td style=\"text-align: left;\">步态轨迹不合理、重心超出支撑域</td>\n<td style=\"text-align: left;\">调整步态参数，降低抬腿高度</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">模式切换摔倒</td>\n<td style=\"text-align: left;\">切换条件不满足、执行过快</td>\n<td style=\"text-align: left;\">降低切换速度，增加过渡</td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"e5\">E.5 感知与导航</h3>\n<table>\n<thead>\n<tr>\n<th style=\"text-align: left;\">故障现象</th>\n<th style=\"text-align: left;\">可能原因</th>\n<th style=\"text-align: left;\">排查方法</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"text-align: left;\">夜间图像噪声大</td>\n<td style=\"text-align: left;\">相机增益过高</td>\n<td style=\"text-align: left;\">调整曝光参数，增加补光</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">激光雷达受干扰</td>\n<td style=\"text-align: left;\">强光或反射面</td>\n<td style=\"text-align: left;\">调整安装角度，滤除异常点</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">目标检测漏检</td>\n<td style=\"text-align: left;\">模型训练不足、光照变化</td>\n<td style=\"text-align: left;\">收集夜间数据微调模型</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">时间同步误差</td>\n<td style=\"text-align: left;\">节点负载过高</td>\n<td style=\"text-align: left;\">降低分辨率，优化回调</td>\n</tr>\n<tr>\n<td style=\"text-align: left;\">超声波误报</td>\n<td style=\"text-align: left;\">声波反射、串扰</td>\n<td style=\"text-align: left;\">调整安装位置，增加滤波</td>\n</tr>\n</tbody>\n</table>","headings":[{"level":2,"id":"e","text":"附录E 常见故障排查表"},{"level":3,"id":"e1","text":"E.1 机械系统"},{"level":3,"id":"e2","text":"E.2 硬件系统"},{"level":3,"id":"e3","text":"E.3 软件系统"},{"level":3,"id":"e4","text":"E.4 运动控制"},{"level":3,"id":"e5","text":"E.5 感知与导航"}]}