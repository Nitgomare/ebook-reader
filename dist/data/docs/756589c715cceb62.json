\"o\">.</span><span class=\"n\">sleep</span><span class=\"p\">(</span><span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">wait_time</span><span class=\"p\">)</span>\n            <span class=\"k\">elif</span> <span class=\"n\">result</span> <span class=\"o\">==</span> <span class=\"n\">TaskResult</span><span class=\"o\">.</span><span class=\"n\">CANCELED</span><span class=\"p\">:</span>\n                <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">get_logger</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">warn</span><span class=\"p\">(</span><span class=\"s1\">&#39;导航被取消，跳过此航点&#39;</span><span class=\"p\">)</span>\n            <span class=\"k\">elif</span> <span class=\"n\">result</span> <span class=\"o\">==</span> <span class=\"n\">TaskResult</span><span class=\"o\">.</span><span class=\"n\">FAILED</span><span class=\"p\">:</span>\n                <span class=\"bp\">self</span><span class=\"o\">.</span><span class=\"n\">get_logger</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">error</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s1\">&#39;导航到航点</span><span class=\"si\">{</span><span class=\"n\">current_index</span><span class=\"o\">+</span><span class=\"mi\">1</span><span class=\"si\">}</span><span class=\"s1\">失败，跳过&#39;</span><span class=\"p\">)</span>\n\n            <span class=\"n\">current_index</span> <span class=\"o\">+=</span> <span class=\"mi\">1</span>\n\n<span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">main</span><span class=\"p\">(</span><span class=\"n\">args</span><span class=\"o\">=</span><span class=\"kc\">None</span><span class=\"p\">):</span>\n    <span class=\"n\">rclpy</span><span class=\"o\">.</span><span class=\"n\">init</span><span class=\"p\">(</span><span class=\"n\">args</span><span class=\"o\">=</span><span class=\"n\">args</span><span class=\"p\">)</span>\n    <span class=\"n\">nod